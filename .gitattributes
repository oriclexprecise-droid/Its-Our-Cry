# Normalize line endings for text files
* text=auto

# Source files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary assets stay untouched
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.dll binary
*.exe binary
*.pth binary
*.ckpt binary
